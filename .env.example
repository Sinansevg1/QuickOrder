# LLM recommendation settings
LlmRecommendation__Enabled=true
LlmRecommendation__MaxSuggestions=3
LlmRecommendation__TimeoutSeconds=10
LlmRecommendation__ProviderPriority__0=openai
LlmRecommendation__ProviderPriority__1=gemini

# OpenAI
LlmRecommendation__OpenAi__Enabled=false
LlmRecommendation__OpenAi__ApiKey=
LlmRecommendation__OpenAi__Model=gpt-4o-mini
LlmRecommendation__OpenAi__Endpoint=https://api.openai.com/v1/chat/completions

# Gemini
LlmRecommendation__Gemini__Enabled=false
LlmRecommendation__Gemini__ApiKey=
LlmRecommendation__Gemini__Model=gemini-1.5-flash
LlmRecommendation__Gemini__Endpoint=
